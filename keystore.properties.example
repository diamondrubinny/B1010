# Copy to keystore.properties (git-ignored) to sign release builds. Never commit real values.
# Create a key once with:
#   keytool -genkeypair -v -keystore willowbrook-release.jks -alias willowbrook -keyalg RSA -keysize 4096 -validity 10000
storeFile=../willowbrook-release.jks
storePassword=CHANGE_ME
keyAlias=willowbrook
keyPassword=CHANGE_ME
